function(nfn_normalize_os_identifier INPUT_VALUE OUTPUT_NAME OUTPUT_DEFINE)
    string(TOLOWER "${INPUT_VALUE}" _nfn_os)

    if(_nfn_os STREQUAL "auto")
        string(TOLOWER "${CMAKE_SYSTEM_NAME}" _nfn_system_name)
        if(_nfn_system_name STREQUAL "windows")
            set(_nfn_os "windows")
        elseif(_nfn_system_name STREQUAL "linux")
            set(_nfn_os "linux")
        endif()
    endif()

    if(_nfn_os STREQUAL "windows")
        set(_nfn_define NFN_OS_WINDOWS)
    elseif(_nfn_os STREQUAL "linux")
        set(_nfn_define NFN_OS_LINUX)
    else()
        message(FATAL_ERROR "Unsupported NFN_TARGET_OS='${INPUT_VALUE}'.")
    endif()

    set(${OUTPUT_NAME} "${_nfn_os}" PARENT_SCOPE)
    set(${OUTPUT_DEFINE} "${_nfn_define}" PARENT_SCOPE)
endfunction()

function(nfn_normalize_arch_identifier INPUT_VALUE OUTPUT_NAME OUTPUT_DEFINE)
    string(TOLOWER "${INPUT_VALUE}" _nfn_arch)

    if(_nfn_arch STREQUAL "auto")
        string(TOLOWER "${CMAKE_SYSTEM_PROCESSOR}" _nfn_processor)
        if(_nfn_processor MATCHES "^(amd64|x86_64|x64)$")
            set(_nfn_arch "x86_64")
        elseif(_nfn_processor MATCHES "^(arm64|aarch64)$")
            set(_nfn_arch "arm64")
        elseif(_nfn_processor STREQUAL "riscv64")
            set(_nfn_arch "riscv64")
        elseif(_nfn_processor MATCHES "^(ppc64le|powerpc64le)$")
            set(_nfn_arch "ppc64le")
        else()
            message(FATAL_ERROR "Unable to infer ISA from CMAKE_SYSTEM_PROCESSOR='${CMAKE_SYSTEM_PROCESSOR}'. Set NFN_TARGET_ARCH explicitly.")
        endif()
    endif()

    if(_nfn_arch STREQUAL "x86_64")
        set(_nfn_define NFN_ARCH_X86_64)
    elseif(_nfn_arch STREQUAL "arm64")
        set(_nfn_define NFN_ARCH_ARM64)
    elseif(_nfn_arch STREQUAL "riscv64")
        set(_nfn_define NFN_ARCH_RISCV64)
    elseif(_nfn_arch STREQUAL "ppc64le")
        set(_nfn_define NFN_ARCH_PPC64le)
    else()
        message(FATAL_ERROR "Unsupported NFN_TARGET_ARCH='${INPUT_VALUE}'.")
    endif()

    set(${OUTPUT_NAME} "${_nfn_arch}" PARENT_SCOPE)
    set(${OUTPUT_DEFINE} "${_nfn_define}" PARENT_SCOPE)
endfunction()

function(nfn_resolve_target_identifiers INPUT_OS INPUT_ARCH OUTPUT_OS_NAME OUTPUT_OS_DEFINE OUTPUT_ARCH_NAME OUTPUT_ARCH_DEFINE)
    nfn_normalize_os_identifier("${INPUT_OS}" _nfn_os_name _nfn_os_define)
    nfn_normalize_arch_identifier("${INPUT_ARCH}" _nfn_arch_name _nfn_arch_define)

    set(${OUTPUT_OS_NAME} "${_nfn_os_name}" PARENT_SCOPE)
    set(${OUTPUT_OS_DEFINE} "${_nfn_os_define}" PARENT_SCOPE)
    set(${OUTPUT_ARCH_NAME} "${_nfn_arch_name}" PARENT_SCOPE)
    set(${OUTPUT_ARCH_DEFINE} "${_nfn_arch_define}" PARENT_SCOPE)
endfunction()

function(nfn_register_external_package TARGET PACKAGE_NAME PACKAGE_DIR)
    if(NOT TARGET ${TARGET})
        message(FATAL_ERROR "nfn_register_external_package: target '${TARGET}' does not exist.")
    endif()

    if(EXISTS "${PACKAGE_DIR}")
        target_include_directories(${TARGET} PRIVATE "${PACKAGE_DIR}")
        message(STATUS "Registered external package '${PACKAGE_NAME}' include: ${PACKAGE_DIR}")
    else()
        message(FATAL_ERROR "External package directory not found: ${PACKAGE_DIR}")
    endif()
endfunction()

function(nfn_link_external_binary_if_exists TARGET LIBRARY_PATH)
    if(EXISTS "${LIBRARY_PATH}")
        target_link_libraries(${TARGET} PRIVATE "${LIBRARY_PATH}")
        message(STATUS "Linked external binary: ${LIBRARY_PATH}")
    endif()
endfunction()
